# Local PostgreSQL development settings.
# Copy this file to .env and choose a local-only password.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
POSTGRES_DB=last_pair
POSTGRES_USER=last_pair_app
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql://last_pair_app:replace_with_a_local_password@localhost:5432/last_pair
